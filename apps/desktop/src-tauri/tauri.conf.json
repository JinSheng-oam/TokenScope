{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TokenScope",
  "version": "0.1.1",
  "identifier": "dev.tokenscope.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "TokenScope — AI 用量监控",
        "width": 1200,
        "height": 800,
        "minWidth": 760,
        "minHeight": 500,
        "center": true,
        "create": false,
        "dragDropEnabled": false,
        "visible": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "useLocalToolsDir": true,
    "windows": {
      "nsis": {
        "installerHooks": "./windows/installer-hooks.nsh"
      },
      "wix": {
        "componentRefs": ["TokenScopeInstallDirectoryGuardMarker"],
        "fragmentPaths": ["./windows/wix/installer-directory-guard.wxs"]
      }
    },
    "publisher": "TokenScope",
    "category": "Utility",
    "shortDescription": "本地优先的 AI Token 用量监控",
    "longDescription": "TokenScope 在本机采集 AI 开发工具的 Token 使用数据，提供用量统计、模型分析和 Antigravity 额度监控。",
    "resources": [
      "resources/tokenscope-agent*",
      "resources/agent-build.json"
    ],
    "icon": [
      "icons/tokenscope-v1/32x32.png",
      "icons/tokenscope-v1/128x128.png",
      "icons/tokenscope-v1/128x128@2x.png",
      "icons/tokenscope-v1/icon.png",
      "icons/tokenscope-v1/icon.ico",
      "icons/tokenscope-v1/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "linux": {
      "deb": {
        "depends": [
          "libwebkit2gtk-4.1-0",
          "libayatana-appindicator3-1",
          "libdbus-1-3"
        ]
      }
    }
  }
}
