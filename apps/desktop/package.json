{
  "name": "tokenscope-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run",
    "build": "tsc --noEmit && vite build",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "reinstall:windows": "pwsh -File ../../scripts/reinstall.ps1",
    "pretauri:dev": "cargo build -p tokenscope-agent && node ../../scripts/stage-agent.mjs --debug",
    "pretauri:build": "cargo build --release -p tokenscope-agent && node ../../scripts/stage-agent.mjs --release"
  },
  "dependencies": {
    "@tauri-apps/api": "2.0.0",
    "svelte": "5.28.0"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "5.0.3",
    "@tauri-apps/cli": "2.0.0",
    "svelte-check": "4.1.5",
    "typescript": "5.8.3",
    "vite": "6.3.5",
    "vitest": "3.2.0"
  }
}
